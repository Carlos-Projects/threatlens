# ThreatLens Configuration
# Copy to .env and customize

# Database path (supports ~ expansion)
THREATLENS_DB_PATH=~/.threatlens/threatlens.db

# Config path
THREATLENS_CONFIG=~/.threatlens/config.yaml

# NVD API key (optional, for CVE enrichment)
# Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook URL (optional)
WEBHOOK_URL=

# Web server
THREATLENS_HOST=127.0.0.1
THREATLENS_PORT=8080
